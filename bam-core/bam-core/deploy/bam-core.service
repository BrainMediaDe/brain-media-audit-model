#
# systemd-Unit fuer den produktiven Betrieb von BAM Core auf
# Debian 13 (Trixie) mit Gunicorn.
#
# Installation:
#   sudo cp deploy/bam-core.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bam-core
#
# Pfade ggf. anpassen (siehe DEPLOYMENT.md).

[Unit]
Description=BAM Core - Brain-Media Audit Model (lokale API + Dashboard)
After=network.target

[Service]
Type=simple
User=bam
Group=bam
WorkingDirectory=/opt/bam-core
Environment="PATH=/opt/bam-core/venv/bin"
ExecStart=/opt/bam-core/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --access-logfile /var/log/bam-core/access.log \
    --error-logfile /var/log/bam-core/error.log \
    bam_api_local:app

Restart=on-failure
RestartSec=5

# Haertung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/bam-core

[Install]
WantedBy=multi-user.target
